<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required even for 127.0.0.1 sockets; the WebView/OkHttp stack talks to the
         bundled llama-server over a real loopback TCP connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Models live wherever the user actually put them on the filesystem, not in app
         storage - llama-server needs a real path, not a SAF content:// URI. Requesting this
         requires sending the user to a system settings screen (see MainActivity); it cannot be
         requested as a normal runtime permission dialog. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Keeps the app (and the llama-server child process it spawns) from being killed just
         because the Activity is backgrounded while a request is in flight. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LlamaWebView"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.LlamaWebView">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LlamaForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_inference_server" />
        </service>
    </application>

</manifest>
